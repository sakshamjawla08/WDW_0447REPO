<body id="top">

    <h1>HTML Link Types &amp; Attributes</h1>

    <!-- 1. INTERNAL LINKS (Same-Page Anchor & Relative Local File) -->
    <h2>1. Internal Links</h2>
    <ul>
        <!-- Jumps to an element with id="footer-section" on the same page -->
        <li><a href="#footer-section">Jump to Bottom Section (Same-Page Anchor)</a></li>
        
        <!-- Links to another HTML file in the same project folder -->
        <li><a href="syllabus.html" title="Open local syllabus file">Go to Syllabus Page (Relative Path)</a></li>
        
        <!-- Downloads a local file instead of navigating to it -->
        <li><a href="notes.pdf" download="WebDev_Notes.pdf">Download Lecture Notes (<code>download</code> attribute)</a></li>
    </ul>

    <hr>

    <!-- 2. EXTERNAL LINKS -->
    <h2>2. External Links</h2>
    <p>
        <!-- target="_blank" opens in a new tab; rel="noopener noreferrer" secures the new tab -->
        Visit the 
        <a href="https://developer.mozilla.org/en-US/docs/Web/HTML" 
           target="_blank" 
           rel="noopener noreferrer" 
           title="Opens MDN Web Docs in a new tab">
           MDN HTML Documentation
        </a> 
        for official specifications.
    </p>

    <hr>

    <!-- 3. EMAIL & TELEPHONE LINKS -->
    <h2>3. Email &amp; Phone Links</h2>
    <ul>
        <!-- Basic mailto link -->
        <li><a href="mailto:instructor@example.com">Send an Email (Basic)</a></li>
        
        <!-- Pre-filled subject and body using URL encoding (%20 = space) -->
        <li>
            <a href="mailto:instructor@example.com?subject=Course%20Question&body=Hello%20Professor,">
                Send Email with Pre-filled Subject &amp; Body
            </a>
        </li>

        <!-- Bonus: Telephone link for mobile devices -->
        <li><a href="tel:+911234567890">Call Department (+91 12345-67890)</a></li>
    </ul>

    <hr>

